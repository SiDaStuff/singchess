# Production build values. Vite loads this file for `vite build` (mode=production)
# automatically, so the correct backend is baked in regardless of which CI/host
# builds it (Netlify, Cloudflare Pages, Workers, or a manual `npm run build`).
#
# The backend API. Override locally/in CI with an explicit VITE_API_URL if you
# need a different target, but leave this pointing at the real backend for
# production deploys.
VITE_API_URL=https://mastermind.singdevelopments.com
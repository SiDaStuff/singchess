{
  "name": "sidastuff-chess-review",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "",
    "build": "vite build && node -e \"const fs=require('fs'); const src='src/stockfish.worker.js'; const dst='dist/src/stockfish.worker.js'; if(fs.existsSync(src)){ fs.mkdirSync('dist/src',{recursive:true}); fs.copyFileSync(src,dst); console.log('Copied '+src+' -> '+dst); }\"",
    "preview": "vite preview",
    "start": "node server/index.cjs",
    "puzzles:build": "node scripts/build-puzzles.mjs",
    "stockfish:copy": "node scripts/copy-stockfish.mjs",
    "build:puzzles": "npm run puzzles:build",
    "pieces:build": "node scripts/build-pieces.mjs",
    "copy:stockfish": "npm run stockfish:copy"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "chess.js": "^0.10.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.10.0",
    "fzstd": "^0.1.1",
    "morgan": "^1.12.0",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^5.0.9",
    "fast-xml-parser": "^5.10.1",
    "ip-address": "^10.4.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "protobufjs": "^7.6.5",
    "uuid": "^11.1.1"
  }
}

{
  "name": "sidastuff-chess-review",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/dev.js",
    "prebuild": "",
    "build": "vite build && node -e \"const fs=require('fs'); const src='src/stockfish.worker.js'; const dst='dist/src/stockfish.worker.js'; if(fs.existsSync(src)){ fs.mkdirSync('dist/src',{recursive:true}); fs.copyFileSync(src,dst); console.log('Copied '+src+' -> '+dst); }\"",
    "preview": "vite preview",
    "start": "node server/index.cjs",
    "puzzles:build": "node scripts/build-puzzles.mjs",
    "stockfish:copy": "node scripts/copy-stockfish.mjs",
    "build:puzzles": "npm run puzzles:build",
    "pieces:build": "node scripts/build-pieces.mjs",
    "copy:stockfish": "npm run stockfish:copy",
    "test": "node scripts/test-fen-repair.cjs && node scripts/test-classify-gate.cjs && node scripts/test-move-explanations.cjs && node scripts/test-explanation-references.mjs && node scripts/test-clock.cjs && node scripts/test-linked-chess.cjs && node scripts/test-sql-database.cjs && node scripts/test-auth-errors.mjs && node scripts/test-puzzles-sql.cjs && node scripts/test-coach-allowance.cjs && node scripts/test-profile-api.cjs && node scripts/test-backfill-sync.cjs && node scripts/test-admin-profile.cjs && node scripts/test-performance.cjs && node scripts/test-analysis-context.cjs && node scripts/test-tactics-coach.cjs && node scripts/test-tactics-advanced.cjs && node scripts/test-tactics-adversarial.cjs",
    "db:status": "node scripts/database.cjs status",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:sync": "node scripts/database.cjs sync",
    "db:backup": "node scripts/database.cjs backup",
    "test:ui": "node scripts/test-ui.mjs",
    "test:ui:states": "node scripts/test-ui-states.mjs",
    "test:ui:linked": "node scripts/test-linked-ui.mjs",
    "test:ui:explanations": "node scripts/test-explanation-ui.mjs",
    "test:ui:auth": "node scripts/test-auth-ui.mjs",
    "puzzles:import-chunks": "node scripts/build-puzzles.mjs --chunks",
    "test:ui:coach": "node scripts/test-coach-ui.mjs",
    "test:ui:admin": "node scripts/test-admin-ui.mjs",
    "test:ui:notifications": "node scripts/test-notification-ui.mjs",
    "test:ui:tactics": "node scripts/test-tactical-ui.mjs",
    "test:ui:annotations": "node scripts/test-board-annotations.mjs",
    "test:play": "node scripts/test-play-state.mjs && node scripts/test-play-api.cjs && node scripts/test-play-review.mjs && node scripts/test-play-board.mjs",
    "test:ui:play": "node scripts/test-play-ui.mjs",
    "test:qol": "node scripts/test-qol-state.mjs && node scripts/test-puzzle-access.cjs",
    "test:ui:qol": "node scripts/test-qol-ui.mjs",
    "test:journey": "node scripts/test-journey-state.mjs",
    "test:ui:journey": "node scripts/test-journey-ui.mjs",
    "test:ui:design": "node scripts/test-design-ui.mjs",
    "db:recover": "node scripts/database.cjs recover"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "better-sqlite3": "12.4.6",
    "canvas-confetti": "^1.9.3",
    "chess.js": "^0.10.3",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "firebase": "^10.12.5",
    "firebase-admin": "^13.10.0",
    "fzstd": "^0.1.1",
    "marked": "^12.0.2",
    "morgan": "^1.12.0",
    "stockfish": "18.0.8",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "playwright-core": "^1.64.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^5.0.9",
    "fast-xml-parser": "^5.10.1",
    "ip-address": "^10.4.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "protobufjs": "^7.6.5",
    "uuid": "^11.1.1"
  }
}

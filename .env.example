# ──────────────────────────────────────────────────────────────────────────
# Sing Chess Review — environment variables.
# Copy this file to `.env` (at the REPO ROOT) and fill in real values.
# The server loads the root .env (server/index.cjs); `npm run dev` (Vite) reads
# VITE_* vars from the same file. NEVER commit a real .env — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# ── Firebase (Admin SDK) — REQUIRED for auth, profiles, quota, everything ──
# Full service-account JSON as a single line (escape newlines as \n) or base64.
# Get it from Firebase Console → Project settings → Service accounts → Generate.
SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}
# Your Realtime Database URL (without trailing slash).
REALTIME_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
LICHESS_TOKEN=
# ── AI Coach LLM providers — at least ONE key is required for the Coach ────
# Inference runs on NVIDIA (see llm-service.js): gpt-oss-120b primary,
# gpt-oss-20b overflow. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
# Optional overrides (defaults in llm-service.js).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Coach exa_search tool (real-time web answers) — optional; tool is hidden
# without a key. https://exa.ai
EXA_API_KEY=
# Legacy provider chain (documented here for rollback; llm-service no longer
# reads these by default):
# LLM_API_KEY= | CEREBRAS_API_KEY= | GROQ_API_KEY= | MISTRAL_API_KEY=

# ── AI Coach tuning (optional — sensible defaults shown) ───────────────────
# Override model ids per provider/tier if desired (defaults are in llm-service.js).
# CEREBRAS_MODEL_FAST= | CEREBRAS_MODEL_STRONG= | GROQ_MODEL_FAST= | GROQ_MODEL_STRONG=
# MISTRAL_MODEL_FAST= | MISTRAL_MODEL_STRONG= | LLM7_MODEL_FAST=
# Circuit breaker for llm7 (fast primary): open after N failures, cooldown in ms.
# LLM_BREAKER_THRESHOLD=3
# LLM_BREAKER_COOLDOWN_MS=30000

# ── reCAPTCHA v3 (signup + contact form) ─────────────────────────────────
# Invisible bot-detection on account creation and support submissions.
# Get keys at https://www.google.com/recaptcha/admin — register a v3 site
# for chess.sidastuff.com (and localhost as a second domain on the same key,
# or as a separate site).
# Server secret — never exposed to the client. Used to verify tokens.
RECAPTCHA_SECRET=
# Browser site key — VITE_ prefix is required for Vite to expose this to the
# browser bundle. Safe to ship in HTML/JS.
VITE_RECAPTCHA_SITE_KEY=
# Dev escape hatch: set to 1 in your local .env to skip server-side
# verification (lets signup/contact work without real keys). DO NOT set in
# production.
RECAPTCHA_DISABLED=

# ── Puzzle DB build (scripts/build-puzzles.mjs — optional) ─────────────────
# Cap imported rows (default: unlimited = multi-GB full Lichess DB import).
# PUZZLE_MAX_ROWS=200000
# Tuning knobs with sensible defaults (see the script for details):
# PUZZLE_JSON_CHUNK_BYTES= | SKIP_PUZZLE_DOWNLOAD= | FORCE_PUZZLE_BUILD= | SKIP_PUZZLE_BUILD=

# ── Server Stockfish (server-side review/anticheat analysis) ───────────────
# The server engine runs the OFFICIAL NATIVE Stockfish binary (AVX2) as a
# persistent UCI child process — NOT the WASM build.
#   win32/x64, linux/x64 → auto-downloads the official sf_18 AVX2 prebuilt into
#                          server/vendor/stockfish-native/ (re-downloads if the
#                          binary is missing or corrupted).
#   linux/arm64          → BUILDS Stockfish 18 from source on first use
#                          (Stockfish ships no Ubuntu ARM64 prebuilt). Requires
#                          g++, make, and wget|curl on the host:
#                            sudo apt install -y g++ make wget curl
#                          The one-time compile (~1-2 min) is cached the same way.
# Browser stays on WASM.
#
# Escape hatch: point at ANY pre-built binary (e.g. one you compiled yourself)
# to skip auto-download/build entirely. It is probed (uciok) on boot.
# SERVER_STOCKFISH_BINARY=/usr/local/bin/stockfish
# Number of UCI threads (default: auto = cores-1, max 4).
# SERVER_STOCKFISH_THREADS=auto
# Transposition hash size in MB (default 128). Larger = stronger at fixed time.
# SERVER_STOCKFISH_HASH=128

# ── Server runtime (optional — defaults shown) ─────────────────────────────
PORT=3000
# Public base URL of this API. When set, served pages get a small bootstrap
# script (window.__API_CONFIG) so browser code can find the API even when the
# SPA is served from a different origin. Leave empty when same-origin.
API_BASE_URL=
# Parallel review engine children (1–4). Keep 1 on small VMs — each child has
# its own thread budget; only raise where there are spare cores.
# SERVER_ENGINE_POOL=1
# Overall wall-clock cap (ms) for a single review request (default 10 min).
# ANALYSIS_WALL_CLOCK_MS=600000
# Serve the built frontend from dist/ alongside the API. Set to 0 if a separate
# web server (nginx/CDN) serves static files.
SERVE_STATIC=1
# Set to 1 when behind a trusted reverse proxy (nginx/Cloudflare) so rate limits
# read X-Forwarded-For correctly. REQUIRED in production behind a proxy.
TRUST_PROXY=1
NODE_ENV=production
# Allow extra CORS origins (space-free, comma-free — add to the allowlist in
# server/index.cjs instead for production). Default production origin:
#   https://chess.sidastuff.com  (+ localhost in dev)
